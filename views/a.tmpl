<!DOCTYPE html>

<html>
  <head>
    <meta charset="utf-8">

    <meta name="HandheldFriendly" content="true">
    <meta name="MobileOptimized" content="640">
    <meta name="mobile-web-app-capable" content="yes" />

    <link rel="icon" href="{{template "base" .}}/images/EAE Logo_Emblem.svg">

    <link rel="stylesheet" href="../lib/bootstrap-icons.css">

    <script type="module" src="./browser.js"></script>

    <script src="./libs.js?v=--TIMESTAMP--"></script>
    <script src="./main.js?v=--TIMESTAMP--"></script>

    <link href="{{template "base" .}}/stylesheets/style.css" rel="stylesheet" />
    <link href="{{template "base" .}}/stylesheets/nav.css" rel="stylesheet" />

    <link href="{{template "base" .}}/tool/lib/mapbox-gl.css" rel="stylesheet" />
    <link href="./main.css" rel="stylesheet" />

    {{template "head" .}}
  </head>

  <body>
    {{template "nav" .}}

    <div id="mobile-switcher"></div>

    <div id="playground">
      <div id="drawer">
        <a for="cards" description="Active Layers"><i class="bi bi-list-task"></i></a>
        <a for="controls" description="Add Layers"><i class="bi bi-plus-lg"></i></a>
        <a for="geographies" description="Change Geographies"><i class="bi bi-globe"></i></a>
        <a for="vectors" description="Search Features"><i class="bi bi-search"></i></a>
        <a for="locations" description="Search POI's"><i class="bi bi-geo"></i></a>
        <a for="points" description="Points Loading"><i class="bi bi-crosshair"></i></a>
      </div>

      <div id="left-panel" style="display: none;">
        <div id="cards" class="search-panel">
          <div id="output-widget">
            <h4>
              Generate Analysis
              <button id="eae-info-button">
                <i class="bi-info-circle"></i>
                <span>About</span>
              </button>
            </h4>

            <div id="selects">
              <div>
                Analysis Area
                <select id="output-variant-select"></select>
              </div>

              <div>
                Prioritization Index
                <select id="index-select"></select>
              </div>
            </div>

            <div id="output-ramp">
              <strong>Priority Legend</strong>
            </div>

            <div class="visibility-group">
              <div id="output-visibility">
                <label>
                  <input id="output-on-map"
                         type="checkbox" checked>
                  &nbsp;
                  Show analysis on map
                </label>
              </div>

              <div id="output-opacity"
                   class="opacity-group">
                <span>Opacity</span>
              </div>
            </div>
          </div>

          <h4>Active Data Layers</h4>

          <div id="cards-buttons">
            <button bind-listen="click"
                    bind-func="visible_all">
              <i class="bi-eye-slash-fill"></i>
              <span>Hide all layers</span>
            </button>

            <button bind-listen="click"
                    bind-func="reset_all">
              <i class="bi bi-arrow-repeat"></i>
              <span>Reset all settings</span>
            </button>

            <button bind-listen="click"
                    bind-func="expand_all">
              <i class="bi bi-arrows-angle-expand"></i>
              <span>Expand all settings</span>
            </button>

            <button bind-listen="click"
                    bind-func="remove_all">
              <span style="color: #c30000;">
                <i class="bi-x-lg"></i>
                <span>Remove all layers</span>
              </span>
            </button>
          </div>

          <div id="cards-list" class="search-results"></div>
        </div>

        <div id="controls" class="search-panel">
          <div class="search-results">
            <div id="controls-tabs"></div>
            <div id="controls-contents"></div>
          </div>
        </div>

        <div id="geographies" class="search-panel">
          <div class="search-results"></div>

          <div id="timeline-graphs">
            <div class="header up-title"
                 style="margin: auto;
                        width: 100%;
                        text-align: center;
                        padding: 10px;">
              <strong id="lines-header"></strong>
            </div>

            <div id="lines-graph" class="graphs"></div>
          </div>
        </div>

        <div id="vectors" class="search-panel">
          <div class="search-results"></div>
        </div>

        <div id="locations" class="search-panel">
          <div class="search-results"></div>
        </div>

        <div id="points" class="search-panel">
          <div id="ponits-buttons" class="panel-buttons">
            <a id="points-download"
               title="Download CSV file of the currents points selection">
              <i class="bi-box-arrow-in-down"></i>
            </a>

            <a id="points-upload">
              <label for="points-input"
                     title="Load a CSV file with points to find within the analysis">
                <i class="bi-box-arrow-in-up"></i>
              </label>
            </a>

            <a id="points-pick"
               title="Pick points on the map to add to the list">
              <i class="bi-geo-alt"></i>
            </a>

            <a id="points-input"
               title="Input coordinates manually">
              <i class="bi-cursor-text"></i>
            </a>
          </div>

          <div class="search-results"></div>
        </div>
      </div>

      <div id="visual">
        <div id="maparea">
          <div id="mapbox-container"></div>
          <!-- timeline will go here -->
        </div>
      </div>

      <button id="right-panel-show" class="button-icon button-icon-mid">
        <span>Show analysis results</span>
        <i class="bi bi-eye-fill"></i>
      </button>

      <div id="right-panel" closed>
        <header id="right-panel-header" style="display: none;">
          <div class="header-top">
            <h2 class="header-title">Analysis results</h2>
            <button id="right-panel-hide" class="button-icon button-icon-sm">
              <i class="bi bi-eye-slash"></i>
              <span>Hide</span>
            </button>
          </div>
          <p class="header-subtitle">Click on an area on the map to learn more about it.</p>

          <div id="right-panel-top-actions">
            <button id="summary-button" class="button-icon top-action-button">
              <i class="bi bi-file-text"></i>
              <span>Report</span>
            </button>

            <button id="disclaimer-button" class="button-icon top-action-button">
              <i class="bi bi-info-circle"></i>
              <span>Disclaimer</span>
              <div id="disclaimer-message">
                <p>
                  The maps are for illustrative purposes and do not imply the
                  expression of any opinion on the part of WRI, concerning the
                  legal status of any country or territory or concerning the
                  delimitation of frontiers or boundaries.
                </p>

                <p>
                  If you use this platform, partially or entirely, you must follow
                  the <a href="https://www.energyaccessexplorer.org/attribution/">attribution instructions</a>.
                </p>
              </div>
            </button>
          </div>
        </header>

        <div id="right-panel-content">
          <div id="analysis-blank-state">
            <div class="blank-state-content">
              <svg class="blank-state-icon" width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M64 60.25H60.25V22.5H48.875V60.25H45.125V37.5H33.875V60.25H30.125V30H18.875V60.25H15.125V41.25H3.75V60.25H0V64H64V60.25Z" fill="#A0D4C1"/>
                <path d="M63.999 15V0H48.874V3.75H57.598L39.499 21.7236L24.499 6.72361L0.549023 30.5494L3.20002 33.2006L24.499 12.0264L39.499 27.0264L60.249 6.40137V15H63.999Z" fill="#A0D4C1"/>
              </svg>
              <p class="blank-state-title">Add data to prioritize analysis</p>
              <p class="blank-state-subtitle">Select a dataset from the left panel to add it to the map and start your prioritization analysis.</p>
            </div>
          </div>

          <div id="analysis-sections-wrapper">
            <div id="analysis-locations"></div>
          </div>

        </div>

        <footer id="right-panel-footer">
          <button id="save-snapshot-button" class="button-icon button-icon-mid footer-action-button">
            <i class="bi bi-bookmark"></i>
            <span>Save</span>
          </button>

          <button id="share-snapshot-button" class="button-icon button-icon-mid footer-action-button">
            <i class="bi bi-share"></i>
            <span>Share</span>
          </button>

          <button id="tiff-download" class="button-icon button-icon-mid footer-action-button" title="Download TIFF image of the current analysis">
            <i class="bi bi-download"></i>
            <span>Export</span>
          </button>
        </footer>
      </div>
    </div>

    {{template "loading" .}}
  </body>

  <template id="controls-template">
    <main>
      <div class="loading">
        <div class="spinner"></div>
      </div>

      <header ripple>
        <span bind="checkbox"></span>
        <span bind="name"></span>

        <buttons>
          <button bind-listen="click"
                  bind-func="card">
            <i class="bi-list-task"></i>
          </button>

          <button bind-listen="click"
                  bind-func="info">
            <i class="bi-info-circle"></i>
          </button>
        </buttons>
      </header>

      <content>
        <span bind="description"></span>
      </content>
    </main>
  </template>

  <template id="card-template">
    <main>
      <handle>
        <i class="bi bi-grip-vertical"></i>
      </handle>

      <content>
        <header>
          <span bind-if="symbol"
                bind="symbol" bind-replace></span>

          <div class="names">
            <div bind="name"></div>

            <div class="index"
                 bind="index"></div>
          </div>

          <div bind-tmpl="#card-header-buttons"></div>
        </header>

        <span bind-if="hosts"
              bind="mutant-options"
              class="mutant-options"></span>

        <div bind-if="colorscale">
          <div bind="colorscale"></div>
          <span bind="ramp"></span>
        </div>

        <span bind-if="pvna">
          <div style="display: inline-block;
                      width: 64px;
                      height: 5px;
                      background-color: rgba(155,155,155,1);
                      margin: 15px 15px 0 0;">
          </div>

          <div style="display: inline-block;
                      font-size: x-small;">
            Not Available
          </div>
        </span>
      </content>
    </main>

    <aside style="display: none;">
      <div class="group"
           bind-if="value-checkboxes.length"
           bind-tmpl="#value-checkboxes-template">
      </div>

      <div class="group"
           bind-if="specs.length"
           bind-tmpl="#specs-list-template">
      </div>

      <div class="group"
           bind-if="manual-inputs">
        <strong bind="unit-label">Range</strong>

        <p class="explain"
           bind="category.unit-explain">
          Analysis will restrict the dataset to the selected range.
        </p>

        <div style="display: flex;
                    justify-content: space-between;">
          <div bind-if="manual-min">
            <span bind="manual-min"></span>
          </div>

          <span bind="range" class="range"></span>

          <div>
            <span bind="manual-max"></span>
          </div>
        </div>
      </div>

      <div bind-if="weight-group"
           class="group">
        <strong>Importance</strong>

        <p class="explain">
          Change importance to provide different weightings for data in the
          analysis calculation.
        </p>

        <span bind="weight-group"></span>
      </div>

      <div class="group">
        <div class="visibility-group">
          <div>
            <label>
              <input type="checkbox"
                     bind-listen="change"
                     bind-func="visibility"
                     checked />
              &nbsp;
              Show layer
            </label>
          </div>

          <div class="opacity-group">
            <span>Opacity</span>
            <span bind="opacity" bind-replace></span>
          </div>
        </div>
      </div>

      <div class="group">
        <buttons>
          <button bind-listen="click"
                  bind-func="info">
            <i class="bi-info-circle"></i> <span>About</span>
          </button>

          <button bind-if="vectors.data"
                  bind-listen="click"
                  bind-func="table">
            <i class="bi-table"></i> <span>Table</span>
          </button>
        </buttons>
      </div>
    </aside>
  </template>

  <template id="ramp">
    <div class="ramp">
      <div bind="left"></div>
      <div bind="middle" class="unit-ramp"></div>
      <div bind="right"></div>
    </div>
  </template>

  <template id="country-overview">
    <div class="country-overview">
      <section>
        <strong>Population:</strong> <span bind="population"></span> million
      </section>

      <section>
        <strong>&nbsp;&nbsp;&nbsp;&nbsp; Urban:</strong> <span bind="urban_population"></span>%
      </section>

      <section>
        <strong>&nbsp;&nbsp;&nbsp;&nbsp; Rural:</strong> <span bind="rural_population"></span>%
      </section>

      <section>
        <strong>Area:</strong> <span bind="area"></span> km<sup>2</sup>
      </section>

      <section>
        <strong>GDP per capita:</strong> USD <span bind="gdp_percapita"></span>
      </section>

      <section>
        <strong>Electrification Rate:</strong> <span bind="electrification"></span>%
      </section>

      <section>
        <div style="display: flex; justify-content: space-around;
                    text-align: center;
                    text-transform: uppercase;
                    color: var(--the-green);">
          <strong style="margin: 0.5em;">Urban</strong>
          <strong style="margin: 0.5em;">Rural</strong>
        </div>

        <div style="display: flex; justify-content: space-around;
                    margin-bottom: 30px;">
          <div style="display: flex; justify-content: space-around; width: 240px; padding: 0 1em;
                      border-right: 1px solid lightgray;">
            <span class="small">
              Electrified:&nbsp; <strong><span bind="urban_electrification"></span>%</strong>
            </span>

            <span bind="urban_electrification_pie"></span>
          </div>

          <div style="display: flex; justify-content: space-around; width: 240px; padding: 0 1em;">
            <span class="small">
              Electrified:&nbsp; <strong><span bind="rural_electrification"></span>%</strong>
            </span>

            <span bind="rural_electrification_pie"></span>
          </div>
        </div>
      </section>

      <section>
        <strong>Energy intensity level of primary energy (MJ/$2011 PPP GDP):</strong> <span bind="primary_intensity"></span>
      </section>

      <section>
        <strong>Power outages in firms in a typical month:</strong> <span bind="outages_average"></span>
      </section>
    </div>
  </template>

  <template id="eae-info-modal-template">
    <h3>About Energy Access Explorer prioritizaton</h3>
    <p>
      Energy Access Explorer enables you to identify high-priority areas for
      energy access interventions. EAE uses multi-criteria analysis that uses
      location-specific resource availability and infrastructure data to
      represent energy supply, and incorporates demographic data and data on
      social and productive uses to visualize demand for energy services.
    </p>

    <br><div style="border-bottom: 1px solid lightgray;"></div><br><br>

    <h3>Analysis areas</h3>
    <p>
      Energy Access Explorer offers the option to generate an analysis across
      various different administrative priorities.
    </p>

    <br>
    <h4>Priority areas (1km²)</h4>
    <p>
      Selecting this analysis area provides a raster analysis in 1km2 tiles
      across the entirity of the selected geography.
    </p>

    <br>
    <h4>Other analysis areas</h4>
    <p>
      Depending on the currently selected geography, it is possible to change
      the priotitization output to wider geographical areas such as districts,
      regions or zones for more high level analysis.
    </p>

    <br><div style="border-bottom: 1px solid lightgray;"></div><br><br>

    <h3>Prioritization indexes</h3>
    <p>
      There are 4 different methods to generate a prioritization, depending on
      the aim of your analysis; these are known as the different
      "indexes". Energy Access Potential is the standard recommended index as it
      is an aggregation across demand and supply categories.
    </p>

    <br>
    <h4 bind="eai.name"></h4>
    <p bind="eai.explain"></p>

    <br>
    <h4 bind="demand.name"></h4>
    <p bind="demand.explain"></p>

    <br>
    <h4 bind="supply.name"></h4>
    <p bind="supply.explain"></p>

    <br>
    <h4 bind="ani.name"></h4>
    <p bind="ani.explain"></p>

    <br><div style="border-bottom: 1px solid lightgray;"></div><br><br>

    <p>
      <a href="https://www.wri.org/publication/energy-access-explorer-data-and-methods">
        <i class="bi-box-arrow-up-right"></i>
        <span>View technical note</span>
      </a>
    </p>
  </template>

  <template id="ds-info-modal">
    <div style="display:flex; flex-flow: row nowrap;">
      <div class="left" style="flex: 1;">
        <section bind-cond="description">
          <h3>Description</h3><pre class="description-text" bind="description"></pre>
        </section>

        <section bind-cond="category-description">
          <h3>Why is this dataset used?</h3><pre class="description-text" bind="category-description"></pre>
        </section>

        <section bind-cond="suggested_citation">
          <h3>Suggested Citation</h3><pre class="description-text" bind="suggested_citation"></pre>
        </section>

        <section bind-cond="cautions">
          <h3>Cautions</h3><pre class="description-text" bind="cautions"></pre>
        </section>
      </div>

      <div class="right" style="flex: 0 300px; padding-left: 3em;">
        <section>
          <a class="download-link"
             bind-cond="download_original_url"
             bind-attr="href"
             bind-arg="download_original_url"
             target="_blank">Download from Source</a>
        </section>

        <section>
          <a class="download-link"
             bind-cond="learn_more_url"
             bind-attr="href"
             bind-arg="learn_more_url"
             target="_blank">Learn More</a>
        </section>

        <section bind-cond="sources">
          <h3>Sources</h3>
          <pre class="description-text" bind="sources"></pre>
        </section>

        <section bind-cond="spatial_resolution">
          <h3>Spatial Resolution</h3>
          <span bind="spatial_resolution"></span>
        </section>

        <section bind-cond="license">
          <h3>License</h3>
          <span bind="license"></span>
        </section>

        <section bind-cond="content_date">
          <h3>Date of Content</h3>
          <span bind="content_date"></span>
        </section>
      </div>
    </div>
  </template>

  <template id="share-link-modal-content">
    <p>
      Sharing the following link will load the Energy Access Explorer platform in
      the current state: layers and analysis.

      Users might need the necessary permissions to view this snapshot fully.
    </p>

    <div id="share-link-input-wrapper">
      <input id="share-link-input"
             class="text-input"
             type="text"
             bind-value="url"
             disabled />

      <button type="button"
              id="share-link-copy-button"
              class="primary-button"
              bind-listen="click"
              bind-func="copy">
        <i class="bi bi-copy"></i>
        <span>Copy link</span>
      </button>
    </div>
  </template>

  <template id="export-options-modal-content">
    <div class="export-options-grid">
      <div class="card-section export-option-card">
        <div class="export-option-icon">
          <i class="bi bi-easel"></i>
        </div>
        <h3 class="card-title">Summary presentation</h3>
        <p class="card-description">A summary presentation explaining the outputs of your current analysis view.</p>
        <button type="button" class="button-small" bind-listen="click" bind-func="export_ppt">
          <i class="bi bi-download"></i>
          <span>Download .ppt</span>
        </button>
      </div>

      <div class="card-section export-option-card">
        <div class="export-option-icon">
          <i class="bi bi-image"></i>
        </div>
        <h3 class="card-title">Map TIFF</h3>
        <p class="card-description">A TIFF file of the prioritization raster image generated from your analysis.</p>
        <button type="button" class="button-small" bind-listen="click" bind-func="export_tiff">
          <i class="bi bi-download"></i>
          <span>Download .TIFF</span>
        </button>
      </div>

      <div class="card-section export-option-card">
        <div class="export-option-icon">
          <i class="bi bi-table"></i>
        </div>
        <h3 class="card-title">High priority areas</h3>
        <p class="card-description">A table of the highest priority <span bind="area_type"></span> areas from your analysis.</p>
        <button type="button" class="button-small" bind-listen="click" bind-func="export_csv">
          <i class="bi bi-download"></i>
          <span>Download .csv</span>
        </button>
      </div>

      <div class="card-section export-option-card">
        <div class="export-option-icon">
          <i class="bi bi-pie-chart"></i>
        </div>
        <h3 class="card-title">Population and area share</h3>
        <p class="card-description">CSV data for the population and area share.</p>
        <button type="button" class="button-small" bind-listen="click" bind-func="export_share_csv">
          <i class="bi bi-download"></i>
          <span>Download .csv</span>
        </button>
      </div>
    </div>
  </template>

  <template id="export-options-modal-footer">
    <div class="modal-footer-bar">
      <button type="button" class="button-icon button-icon-mid" bind-listen="click" bind-func="export_all">
        <i class="bi bi-file-earmark-zip"></i>
        <span>Download all</span>
      </button>
    </div>
  </template>

  <template id="index-graph-section-template">
    <panel-section class="index-graphs-section">
      <span slot="title"></span>
      <div slot="actions">
        <button class="button-icon button-info button-about">
          <span>About</span>
          <i class="bi bi-info-circle"></i>
        </button>
      </div>
      <div class="share-graph">
        <div class="section-description"></div>
        <div class="graph-and-scale">
          <div class="index-graphs-scale-container"></div>
          <div class="index-graphs-group"></div>
        </div>
      </div>
    </panel-section>
  </template>

  <template id="analysis-locations-template">
    <panel-section id="analysis-locations-section" collapsible collapsed>
      <h2 slot="title">High priority areas</h2>
      <div slot="actions">
        <button class="button-icon button-info button-about">
          <span>About</span>
          <i class="bi bi-info-circle"></i>
        </button>
      </div>
      <div class="locations-paginated-list"></div>
      <footer class="locations-footer">
        <button id="view-all-locations" class="button-icon button-icon-mid" bind-listen="click" bind-func="view_all_locations">
          <i class="bi bi-table"></i>
          <span>View all</span>
        </button>
        <button id="download-locations-data" class="button-icon button-icon-mid" bind-listen="click" bind-func="download_locations_data">
          <i class="bi bi-download"></i>
          <span>Download data</span>
        </button>
      </footer>
    </panel-section>
  </template>

  <template id="geographies-search-item">
    <div bind="name"></div>

    <buttons>
      <span class="bi-zoom-in"
            zoom="true"></span>

      <span class="bi-box-arrow-in-down"
            bind-cond="url"
            bind-attr="href"
            bind-arg="url"></span>
    </buttons>
  </template>

  <template id="points-input-form">
    <form>
      <input id="lng"
             type="number"
             step="any"
             placeholder="Longitude"
             style="padding: 5px 7px;">

      <input id="lat"
             type="number"
             step="any"
             placeholder="Latitude"
             style="padding: 5px 7px;">

      <br><br>

      <button type="submit"
              class="big-green-button"
              style="font-size: 0.8em; margin: auto;">Add point</button>
    </form>
  </template>

  <template id="value-checkboxes-template">
    <label bind-each="value-checkboxes"
           class="checkbox-row">
      <span bind-init="color"
            style="display:block;
                   height: 20px;
                   width: 20px;"></span>

      <span bind="name"></span>

      <input type="checkbox"
             bind-attr-checked="checked"
             bind-value="value"
             bind-listen="change"
             bind-func="change">
    </label>
  </template>

  <template id="specs-list-template">
    <label bind-each="specs"
           class="checkbox-row">
      <span bind="csymbol"></span>

      <span bind="cname"></span>

      <input type="checkbox"
             bind-value="cname"
             bind-attr-checked="checked"
             bind-listen="change"
             bind-func="change">
    </label>
  </template>

  <template id="card-header-buttons">
    <buttons>
      <button bind-listen="click"
              bind-func="settings"
              title="Hide/Show settings">
        <i class="bi-chevron-down"></i>
      </button>

      <button bind-listen="click"
              bind-func="close"
              title="Remove dataset">
        <i class="bi-x-lg"></i>
      </button>
    </buttons>
  </template>

  <template id="map-info-template">
    <span class="dot"></span>
    <span class="arrow"></span>
    <main>
      <header>
        <div class="header-content">
          <div class="title" bind-cond="feature" bind="feature"></div>
          <div class="title coordinate-title" bind-cond="coordinate-title">
            <i class="bi-crosshair"></i>
            <span bind="coordinates"></span>
          </div>
          <div class="caption" bind-cond="feature_type" bind="feature_type"></div>
        </div>
        <div class="close-button-container">
          <div class="close-button"></div>
        </div>
      </header>
      <content bind-cond="has-basic">
        <table>
          <tr bind-each="basicData">
            <td bind="label"></td>
            <td bind="value"></td>
          </tr>
        </table>
      </content>
      <content class="detailed-data hidden" bind-cond="has-detailed">
        <table>
          <tr bind-each="detailedData">
            <td>
              <i class="bi-chevron-right subordinate-toggle" bind-cond="has_subordinates"></i>
              <span bind="label"></span>
            </td>
            <td bind="value"></td>
          </tr>
        </table>
      </content>
      <div class="analyse-button-container" bind-cond="has-detailed">
        <button class="analyse-button">Analyse selected area</button>
      </div>
    </main>
  </template>

  <template id="toast-notification-template">
    <div class="toast-icon">
      <i class="bi bi-check-circle-fill"></i>
    </div>
    <div class="toast-content">
      <header class="toast-header">
        <h1 class="toast-label" bind="label"></h1>
        <p class="toast-caption" bind="caption"></p>
      </header>
      <footer class="toast-footer">
        <div>
          <slot name="action"></slot>
        </div>
      </footer>
    </div>
  </template>

  <template id="toast-save-action-template">
    <a href="/tool/m/" target="_blank" class="button-small" slot="action">View in My EAE</a>
  </template>

  <template id="request-authentication-modal-template">
    <p>
      Create a My EAE account, or sign in to your existing account in order to save your current analysis view and receive important updates about the Energy Access Explorer platform.
    </p>
    <a href="/subscribe/?select=account" target="_blank" class="primary-button">Create account</a>
    <a href="/login" class="secondary-button">Sign in</a>
  </template>

  <template id="saved-analysis-modal-template">
    <p>
      You are currently viewing an analysis already saved to your My EAE account. You can either update your existing saved analysis, or save your changes as a new analysis.
    </p>
    <div class="saved-analysis-info">
      <div class="saved-analysis-name">
        <i class="bi bi-bookmark-fill"></i>
        <span bind="title"></span>
      </div>
      <div class="saved-analysis-last-viewed" bind="last-viewed"></div>
    </div>
    <button class="button primary-button" bind-listen="click" bind-func="update">Update saved analysis</button>
    <button class="button secondary-button" bind-listen="click" bind-func="saveAsNew">Save as new analysis</button>
  </template>

  <template id="edit-title-form-template">
    <form id="save-analysis" class="save-analysis-form">
      <div class="text-input-wrapper">
        <label class="text-input-label required">Analysis title</label>
        <div class="text-input-hint">Enter a memorable name for the current configuration.</div>
      </div>
      <div class="field-wrapper">
        <input class="text-input" name="title" required />
      </div>
    </form>
    <button type="submit" form="save-analysis" class="primary-button">Save analysis</button>
  </template>

  <template id="discrete-scale-item-template">
    <div class="scale-item">
      <dt class="scale-item-label">
        <div class="scale-item-spacer">
          <span class="scale-circle" bind-init="color"></span>
        </div>
        <span bind="label"></span>
      </dt>
      <dd class="scale-item-value" bind="value"></dd>
    </div>
  </template>

  <template id="panel-section-template">
    <div class="card-section" data-collapsed="false">
      <div class="card-header">
        <div class="card-title-group"></div>
        <div class="card-actions"></div>
      </div>
      <div class="card-body"></div>
    </div>
  </template>

  <template id="panel-section-collapsible-template">
    <div class="card-section" data-collapsed="false">
      <div class="card-header">
        <div class="card-title-group"></div>
        <div class="card-actions">
          <i class="bi bi-chevron-down visibility-toggle-switch"></i>
        </div>
      </div>
      <div class="card-body"></div>
    </div>
  </template>

  <template id="location-item-template">
    <li class="location-item">
      <div class="location-item-content">
        <i class="bi bi-crosshair location-target-icon"></i>
        <div class="location-info">
          <div class="location-name" bind="location-name"></div>
          <div class="location-coordinates" bind="coordinates"></div>
        </div>
        <i class="bi bi-chevron-right location-chevron"></i>
      </div>
    </li>
  </template>

  <template id="admin-area-item-template">
    <li class="location-item admin-area-item">
      <div class="location-item-content">
        <span class="admin-area-rank" bind="rank"></span>
        <div class="location-info">
          <div class="location-name" bind="location-name"></div>
        </div>
        <i class="bi bi-chevron-right location-chevron"></i>
      </div>
    </li>
  </template>

  <template id="location-group-template">
    <li class="location-group">
      <div class="location-group-header">
        <span bind="score-text"></span>
        <span class="location-area-badge" bind="area-count"></span>
      </div>
      <ul class="location-group-list"></ul>
    </li>
  </template>

  <template id="pagination-template">
    <div class="pagination-container">
      <div class="pagination-info" bind="info-text"></div>
      <div class="pagination"></div>
    </div>
  </template>

  <template id="high-priority-areas-list-all-template">
    <div class="high-priority-areas-list-all-content">
      <p class="high-priority-areas-list-all-subtitle" bind="analysis-name"></p>
      <div class="high-priority-areas-list-all-table-container">
        <table class="high-priority-areas-list-all-table">
          <thead>
            <tr>
              <th class="checkbox-column">
                <input type="checkbox" class="select-all-checkbox hidden" bind-listen="change" bind-func="on_uncheck_all">
              </th>
              <th bind-each="headers" bind-listen="click" bind-func="on_sort">
                <div class="th-content">
                  <span bind="name"></span>
                  <span class="sort-icon"><i class="bi bi-chevron-expand"></i></span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        <div class="selection-overlay hidden">
          <span class="selection-count"></span>
          <button class="button-icon button-icon-mid" bind-listen="click" bind-func="download_selected">
            <span>Download selected rows</span>
          </button>
        </div>
      </div>
      <div class="pagination-container">
        <div class="per-page-control">
          <select class="per-page-select" bind-listen="change" bind-func="on_per_page_change">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
          <span class="per-page-label">Per page</span>
        </div>
        <div class="pagination">
          <button class="pagination-btn chevron" bind-listen="click" bind-func="on_prev">
            <i class="bi bi-chevron-left"></i>
          </button>
          <div class="page-numbers"></div>
          <button class="pagination-btn chevron" bind-listen="click" bind-func="on_next">
            <i class="bi bi-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
  </template>

  <template id="high-priority-areas-list-all-footer-template">
    <div class="modal-footer-bar">
      <button class="button-icon button-icon-mid" bind-listen="click" bind-func="download">
        <i class="bi bi-download"></i>
        <span>Download all (.csv)</span>
      </button>
      <div class="info">
        <i class="bi bi-info-circle"></i>
        <span>Data download will include a summary of your analysis.</span>
      </div>
    </div>
  </template>

  <template id="high-priority-areas-row-template">
    <tr>
      <td class="checkbox-column">
        <input type="checkbox" bind-listen="change" bind-func="on_select">
      </td>
      <td bind-each="cells" bind="value"></td>
    </tr>
  </template>

  <template id="page-number-template">
    <button class="pagination-btn page-number" bind-listen="click" bind-func="on_click" bind="value"></button>
  </template>

  <template id="page-ellipsis-template">
    <span class="page-ellipsis">...</span>
  </template>

  <template id="modal-header-template">
    <div>
      <div class="modal-title" bind="title"></div>
      <div class="modal-subtitle" bind="subtitle"></div>
    </div>
  </template>

  {{template "env" .}}

  <script type="module">
    import flash from '../lib/flash.js';
    import pgrest from '../lib/pgrest.js';

    window.FLASH = new flash();
    window.API = new pgrest(EAE['settings'].database, FLASH);

    window.GEOGRAPHY = null;
    window.SNAPSHOT = null;
    window.OUTLINE = null;
    window.MAPBOX = null;
    window.COORDINATESMODE = false;
    window.COORDINATES = [];
    window.MOBILE = false;
    window.DST = new Map();
    window.SELF = null;
    window.STATE = null;
    window.DEBUG = true;
    window.COMMIT = null;
    window.SUMMARY = null;
  </script>

  <script type="module">
    import './panel-section.js';
    import {init} from './a.js';
    init();
  </script>
</html>
