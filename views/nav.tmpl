{{define "nav"}}
<nav>
  <input id="toggle"
         class="no-desktop"
         type="checkbox">

  <label for="toggle" class="no-desktop">
    <svg style="width:24px;height:24px" viewBox="0 0 24 14">
      <path d="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" />
    </svg>
  </label>

  <a id="energy-access-link"
     href="{{template "base" .}}/">
    <img src="{{template "base" .}}/images/EAE Logo_Horizontal White.svg">
  </a>

  <div id="navigation-links">
    <a href="{{template "base" .}}/tool/s"
       class="toggleable">
      Tool
    </a>

    <a href="{{template "base" .}}/about"
       class="toggleable">
      About
    </a>

    <a href="{{template "base" .}}/get-involved"
       class="toggleable">
      Get Involved
    </a>

    <a href="{{template "base" .}}/user-stories"
       class="toggleable">
      User Stories
    </a>

    <a href="{{template "base" .}}/partners"
       class="toggleable">
      Partners
    </a>
  </div>
</nav>

<script src="{{template "base" .}}/javascripts/nav.js"></script>
{{end}}
