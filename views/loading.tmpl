{{define "loading"}}
<div id="app-loading" class="loading">
  <div class="spinner"></div>
  <p id="loading-message">Loading...</p>
  <p id="loading-progress" style="display:none"></p>
  <p>
    <button id="loading-cancel" class="primary-button" style="display:none" type="button">Cancel</button>
  </p>
</div>
{{end}}
