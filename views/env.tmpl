{{define "env"}}
<script type="module">
  import {
    extract as user_extract,
  } from './user.js';

  import {
    ce,
    maybe,
  } from '../lib/helpers.js';

  let e;
  if (location.hostname.match(/localhost|linux/)) {
    const url = new URL(location);
    e = url.searchParams.get('env') || 'public';
  }
  else {
    const match = location.hostname.match(new RegExp(`^(.*)\\.${EAE['settings'].domain}`));
    if (!match) {
      e = 'public';
    }
    else {
      const subdomain = match[1];

      switch (subdomain) {
      case 'www':
      case '':
        e = 'public';
        break;

      default:
        e = subdomain;
        break;
      }
    }
  }

  if (e !== 'public') {
    if (!user_extract('id')) window.location = '{{template "base" .}}/login';

    document.head.append(ce('link', null, { "rel": "stylesheet", "href": "{{template "base" .}}/stylesheets/env.css" }))
    document.querySelector('[href="{{template "base" .}}/"]').setAttribute('data-content', e);
  }

  window.ENV = (e === 'test') ? ['public', 'test'] : [e];
</script>
{{end}}
