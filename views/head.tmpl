{{define "head"}}
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>html:not(.i18n-ready) body { visibility: hidden; }</style>
<script>addEventListener('DOMContentLoaded', function() { document.documentElement.classList.add('i18n-ready'); });</script>

{{template "sentry" .}}

{{template "hotjar" .}}

{{template "google" .}}

{{template "transifex" .}}

{{template "cookie" .}}

<script>
  document.title = EAE['settings'].title;

  window.BASE = "";

  if (location.hostname.match(/^(test|dev)/)) {
    var prefix = location.pathname.split('/')[1];

    if (prefix && prefix !== "tool" && prefix !== "admin")
      window.BASE = "/" + prefix;
  }
</script>
{{end}}
